# ---------- Database ----------
# Used by the Node API, the Python AI service, and the ingestion scripts.
DATABASE_URL=postgresql://bis:bis@localhost:5432/bis

# ---------- Node orchestration API (node-api) ----------
PORT=4000
JWT_SECRET=change-me-in-production
AI_SERVICE_URL=http://localhost:8000

# ---------- Python AI service ----------
# Embedding backend: "hash" (offline, zero-dependency default) | "minilm" (sentence-transformers
# all-MiniLM-L6-v2, install sentence-transformers separately) | "api" (OpenAI-compatible endpoint).
EMBEDDING_BACKEND=hash
EMBEDDING_DIM=384
# Only used when EMBEDDING_BACKEND=api (OpenAI-compatible /embeddings endpoint):
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=

# LLM provider for answer synthesis: leave LLM_API_KEY empty to use the built-in
# offline extractive synthesizer (deterministic, citation-grounded, no network).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Retrieval tuning
RETRIEVAL_K=6
# Grounding gate: top-chunk cosine below this -> honest refusal instead of improvisation.
# Calibrated: real queries >= 0.35, off-corpus <= 0.25 on the seeded corpus.
GROUNDING_THRESHOLD=0.30
